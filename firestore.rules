rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.email == 'itsuppdpm@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidStore(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!data.keys().hasAny(['theme']) || (data.theme is map && data.theme.font is string && data.theme.primaryColor is string));
    }

    function isValidScreen(data) {
      return data.name is string && data.name.size() > 0
        && (!data.keys().hasAny(['backgroundImage']) || data.backgroundImage is string)
        && (!data.keys().hasAny(['isStaging']) || data.isStaging is bool);
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0
        && data.x is number && data.x >= 0 && data.x <= 100
        && data.y is number && data.y >= 0 && data.y <= 100
        && (!data.keys().hasAny(['order']) || data.order is number);
    }

    function isValidItem(data) {
      return data.name is string && data.name.size() > 0
        && data.priceLabel is string && data.priceLabel.size() <= 200
        && (!data.keys().hasAny(['order']) || data.order is number);
    }

    // Root collection: Stores
    match /stores/{storeId} {
      allow read, write: if true; // Public access for development as requested

      // Subcollection: Screens
      match /screens/{screenId} {
        allow read, write: if true;

        // Subcollection: Categories
        match /categories/{categoryId} {
          allow read, write: if true;

          // Subcollection: Items
          match /items/{itemId} {
            allow read, write: if true;
          }
        }
      }
    }
  }
}
